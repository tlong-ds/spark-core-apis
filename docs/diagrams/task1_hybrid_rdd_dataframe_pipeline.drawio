        <!-- Action 1 / Job 0 -->
        <mxCell id="21" value="Action 1: Semantic Counts (Job 0)" style="swimlane;html=1;startSize=30;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="20">
          <mxGeometry x="35" y="50" width="840" height="210" as="geometry"/>
