        <mxCell id="41" value=".filter(http_status == &apos;200&apos;)&#xa;Predicate Filter cục bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="40">
