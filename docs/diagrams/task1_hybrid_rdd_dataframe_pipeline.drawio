        <!-- Action 2 / Job 1 -->
        <mxCell id="30" value="Action 2: Top Countries for Valid HTTP 200 (Job 1)" style="swimlane;html=1;startSize=30;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="20">
          <mxGeometry x="35" y="285" width="840" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="31" value=".filter(state == &apos;valid&apos; &amp;&#xa;        status == &apos;200&apos;)&#xa;Catalyst Filter Pushdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="30">
          <mxGeometry x="30" y="60" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="32" value=".groupBy(&quot;country&quot;)&#xa;Exchange (Shuffle by country)&#xa;HashAggregate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="30">
          <mxGeometry x="270" y="60" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="33" value=".orderBy(desc(&apos;access_count&apos;))&#xa;.limit(10).collect()&#xa;TakeOrderedAndProject (Top 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="30">
          <mxGeometry x="520" y="60" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="Đạt chuẩn Top-k tương đương 100% với nhánh RDD và DataFrame" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#64748b;" vertex="1" parent="30">
          <mxGeometry x="220" y="180" width="400" height="30" as="geometry"/>
