  <diagram id="task1-hybrid-pipeline" name="Hybrid RDD to DataFrame Pipeline">
    <mxGraphModel dx="1950" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="2" value="Task 1 Hybrid Pipeline — RDD Parsing to Structured DataFrame Analytics" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="250" y="25" width="1450" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="2b" value="Architectural Boundary: Procedural RDD parsing for messy logs → Explicit StructType mapping → Catalyst-optimized DataFrame queries" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=2;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="250" y="65" width="1450" height="30" as="geometry"/>
        </mxCell>

        <!-- Tier 1: Low-Level RDD Parsing -->
        <mxCell id="3" value="Tier 1: Low-Level RDD Processing (Python / Lineage)" style="swimlane;html=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="450" height="830" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="sc.textFile(input_path)&#xa;Read raw text files as RDD[String]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="60" y="60" width="330" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="flatMap(unpack_compound_logs)&#xa;Split compound logs (; separator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="60" y="160" width="330" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="map(parse_log_entry)&#xa;Regex extraction (IP, status, endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="60" y="265" width="330" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="map(_classify_parsed)&#xa;+ Broadcast CIDR Lookup Table&#xa;Valid / Malformed / Unknown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="3">
          <mxGeometry x="60" y="370" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="rows (Classified RDD)&#xa;RDD of canonical output tuples:&#xa;(state, reason, ip, status, country, raw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16;" vertex="1" parent="3">
          <mxGeometry x="50" y="490" width="350" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="8b" value="Ưu thế của RDD tại Tier 1:&#xa;• Linh hoạt xử lý cấu trúc log phi tiêu chuẩn&#xa;• Tách dòng compound và Regex an toàn&#xa;• Lookup dải CIDR nhị phân tùy biến" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=14;align=left;spacingLeft=12;fontColor=#334155;" vertex="1" parent="3">
          <mxGeometry x="50" y="640" width="350" height="110" as="geometry"/>
        </mxCell>

        <!-- Tier 2: Boundary Bridge -->
        <mxCell id="9" value="Tier 2: Boundary Bridge" style="swimlane;html=1;startSize=36;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="290" width="380" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="OUTPUT_SCHEMA&#xa;StructType([&#xa;  record_state, reason, ip,&#xa;  http_status, country, raw&#xa;])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;fontSize=14;align=left;spacingLeft=16;" vertex="1" parent="9">
